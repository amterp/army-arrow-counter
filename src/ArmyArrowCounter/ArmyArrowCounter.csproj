<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ArmyArrowCounter</AssemblyName>
    <RootNamespace>ArmyArrowCounter</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The game version this build targets. A game update changes this line and nothing else. -->
    <BannerlordVersion>1.4.8.119303</BannerlordVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="$(BannerlordVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Assemble the folder a player drops into Modules/, so packaging is part of the
       build rather than a step someone has to remember. -->
  <PropertyGroup>
    <ModuleDir>$(MSBuildProjectDirectory)/../../build/ArmyArrowCounter</ModuleDir>
  </PropertyGroup>

  <ItemGroup>
    <ModuleContent Include="../SubModule.xml" PackagePath="" />
    <ModuleContent Include="../config/**/*" PackagePath="config" />
    <ModuleContent Include="../GUI/**/*" PackagePath="GUI" />
  </ItemGroup>

  <Target Name="AssembleModule" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleDir)/bin/Win64_Shipping_Client" />
    <Copy SourceFiles="@(ModuleContent)"
          DestinationFiles="@(ModuleContent->'$(ModuleDir)/%(PackagePath)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
