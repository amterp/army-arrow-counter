<Project>
  <!-- Shared by the mod and the test project. The Core/ sources compile into both,
       so these must not drift. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- The game release everything targets. A compatibility update changes this line. -->
    <BannerlordVersion>1.4.8.119303</BannerlordVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
</Project>
